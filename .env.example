# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Gemini API key for AI message generation (Convex backend only — do NOT prefix with VITE_)
# Set on your Convex deployment with:
#   npx convex env set GEMINI_API_KEY your_key_here
GEMINI_API_KEY=

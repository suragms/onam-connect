# ==============================================================================
# ONAMCONNECT — Vercel Environment Configuration
# ==============================================================================
# Copy these values into your Vercel Project Settings -> Environment Variables.
# https://vercel.com/docs/projects/environment-variables
# ==============================================================================

# [REQUIRED] Convex Backend Cloud URL used by Vite frontend
VITE_CONVEX_URL=https://good-otter-826.convex.cloud

# [REQUIRED] Production Convex Deployment Identifier
CONVEX_DEPLOYMENT=prod:good-otter-826

# [OPTIONAL] Canonical Site URL for Auth and Callbacks (update with your Vercel URL)
CONVEX_SITE_URL=https://onamconnect.app

# ==============================================================================
# NOTE ON GEMINI_API_KEY:
# Gemini AI requests run on Convex serverless backend actions in production.
# Do NOT add GEMINI_API_KEY to Vercel. Set it in Convex Cloud using:
#   npx convex env set GEMINI_API_KEY <your_gemini_api_key>
# ==============================================================================
